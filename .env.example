# ========================================================
# Cheque Management System - Environment Variables
# Reliable Drapes (RD) & Shree Ambica Furnishings (SAF)
# ========================================================

# Port for the web server (defaults to 5000)
PORT=5000

# Node Environment ('production' or 'development')
NODE_ENV=production

# Supabase Cloud Database Credentials
# Find these in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key-here
